# ============================================================================
# Curate AI — Backend (Fastify + SQLite retrieval engine)
# ============================================================================
FROM node:24-slim AS build
RUN corepack enable
WORKDIR /app

# Install dependencies (layer-cached on lockfile changes)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/backend/package.json packages/backend/package.json
RUN pnpm install --frozen-lockfile

# Build backend (tsup bundles TS, externalizes runtime deps)
COPY . .
RUN pnpm --filter @curate-ai/backend build

# ============================================================================
# Runtime — production deps only, non-root user
# ============================================================================
FROM node:24-slim AS runtime
RUN corepack enable
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app ./
ENV CI=true
RUN pnpm install --prod --frozen-lockfile && \
    mkdir -p /app/data && chown -R node:node /app

# node:24-slim ships a built-in `node` user (uid/gid 1000)
USER node
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:4000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "packages/backend/dist/index.js", "serve"]
