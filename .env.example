# ===== Curate AI — Backend =====
# Fastify server
HOST=0.0.0.0
PORT=4000

# SQLite database file (relative to backend package, or absolute)
DATABASE_PATH=./data/curate.db

# Local embedding model (transformers.js, downloaded once to HF_CACHE)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384
HF_CACHE=./data/hf-cache

# Ingestion
# Live fetch sources: comma-separated subset of arxiv,rss,reddit
INGEST_SOURCES=arxiv,rss,reddit
ARXIV_MAX_RESULTS=30

# LLM reranking (pi SDK agent stage, mode=rerank)
# Uses your ~/.pi/agent login by default; override with an API key for cron/containers.
RERANK_PROVIDER=opencode-go
RERANK_MODEL=deepseek-v4-flash
# RERANK_API_KEY=
RERANK_TOP_N=25
RERANK_TIMEOUT_MS=60000

# LLM query expansion (pi SDK agent stage, mode=expand / expand-rerank)
# Same provider/auth as rerank.
EXPANSIONS_PER_QUERY=3
EXPAND_TIMEOUT_MS=45000

# Frontend origin (CORS, dev)
FRONTEND_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
