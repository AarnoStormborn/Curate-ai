# ===== Curate AI — Backend =====
# Fastify server
HOST=0.0.0.0
PORT=4000

# SQLite database file (relative to backend package, or absolute)
DATABASE_PATH=./data/curate.db

# Local embedding model (transformers.js, downloaded once to HF_CACHE)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384
HF_CACHE=./data/hf-cache

# Ingestion
# Live fetch sources: comma-separated subset of arxiv,rss,reddit
INGEST_SOURCES=arxiv,rss,reddit
ARXIV_MAX_RESULTS=30

# Frontend origin (CORS, dev)
FRONTEND_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
